# Copy to .env and fill in. Do not commit .env.

# Discord bot token (Developer Portal > Bot > Token)
DISCORD_TOKEN=<DISCORD_TOKEN>
# Server (guild) ID the bot manages
DISCORD_GUILD=<GUILD_ID>
# Application ID (Developer Portal > General Information)
DISCORD_APP=<APP_ID>
# Number of Blue Teams in the competition
BLUE_TEAMS=<NUM_BLUE_TEAMS>

# MySQL credentials, used by both the bot and the mysql container
DB_USER=cobi
DB_PASS=<DB_PASSWORD>
DB_DATABASE=cobi

# Optional: Uptrace DSN for traces and logs. Leave empty to disable.
UPTRACE_DSN=
